{
  "id": "hmgapi-comfort",
  "name": "Comfort & Startup",
  "version": "1.1.5",
  "hmgapi": ">=1.0.0",
  "authors": ["lemoyneiv"],
  "license": "AGPL-3.0",
  "repo": "https://github.com/lemoyneiv/hmgapi-comfort",
  "nemesis_conflicts": ["coldstart.heat", "local.hkmc.factory82"],
  "description": "Automatic multi-tier cold-start seat & steering wheel warming, summer seat ventilation, automatic front-passenger occupancy & late-boarding detection, rear seat policies, and startup notice dismissal.",
  "live": true,
  "usb": ["ComfortProbe"],
  "apps": [
    {
      "apk": "app/Comfort.apk",
      "package": "dev.lemoyne.comfort"
    }
  ],
  "services": [
    {
      "name": "welcome",
      "jar": "app/Comfort.apk",
      "class": "dev.lemoyne.comfort.WelcomeDaemon",
      "user": "system",
      "start": "boot",
      "restart": true
    },
    {
      "name": "starter",
      "script": "svc/start.sh",
      "user": "system",
      "start": "android",
      "restart": false
    }
  ],
  "vehicle": {
    "read": [
      "hv.ready",
      "gear.park",
      "charging",
      "outside_temp_f",
      "outside_temp",
      "wheel_heat",
      "seat_heat.driver",
      "seat_heat.passenger",
      "seat_heat.rear_left",
      "seat_heat.rear_right",
      "seat_vent.driver",
      "seat_vent.passenger",
      "seat_state.driver",
      "seat_state.passenger",
      "seat_state.rear_left",
      "seat_state.rear_right"
    ],
    "commands": [
      "startup_notice",
      "seat_heat",
      "seat_vent",
      "wheel_heat"
    ]
  },
  "provides": {
    "launcher": [
      {
        "title": "Comfort",
        "package": "dev.lemoyne.comfort",
        "class": ".MainActivity",
        "icon": "icons/icon.png",
        "icon_night": "icons/icon_night.png",
        "icon_disabled": "icons/icon_disabled.png",
        "icon_disabled_night": "icons/icon_disabled_night.png"
      }
    ],
    "star_key": [
      {
        "id": "open",
        "title": "Comfort & Startup",
        "activity": {
          "package": "dev.lemoyne.comfort",
          "class": ".MainActivity"
        }
      }
    ]
  },
  "logs": {
    "tags": ["HmgComfort"],
    "match": ["[hmgapi-comfort]"]
  }
}
